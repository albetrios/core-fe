{
  "name": "core-fe",
  "private": true,
  "version": "1.9.2",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.15",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tooling/ci/strip-sourcemaps.mjs",
    "build:check": "node tooling/ci/check-preload-graph.mjs && node tooling/ci/check-css-sources.mjs && node tooling/ci/check-no-sourcemaps.mjs",
    "preview": "vite preview",
    "preview:https": "vite preview --https",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:security": "vitest run --project security",
    "test:ci-policy": "vitest run --project ci-policy",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "rm -rf test-results 2>/dev/null || true && playwright test",
    "test:e2e:integration": "playwright test tests/e2e/routes-integration.e2e.test.ts tests/e2e/org-switching.e2e.test.ts",
    "test:e2e:integration:cross-browser": "playwright test --config playwright.integration-cross-browser.config.ts",
    "test:cross-browser": "playwright test --config playwright.cross-browser.config.ts",
    "test:e2e:report": "playwright show-report test-results/report",
    "security:secrets": "gitleaks detect --source . -v",
    "security:sast": "semgrep --config auto .",
    "tsdoc:check": "node tooling/tsdoc-coverage/check-coverage.mjs",
    "tsdoc:check:report": "node tooling/tsdoc-coverage/check-coverage.mjs --report",
    "tsdoc:check:refresh-budget": "node tooling/tsdoc-coverage/check-coverage.mjs --refresh-budget",
    "knip": "knip",
    "docs:lint": "markdownlint-cli2",
    "docs:lint:fix": "markdownlint-cli2 --fix",
    "docs:lint:changed": "bash tooling/ci/lint-changed-markdown.sh",
    "docs:api": "typedoc",
    "sonar:up": "docker compose -f docker-compose.sonar.yml up -d sonarqube",
    "sonar:down": "docker compose -f docker-compose.sonar.yml down",
    "sonar:reset": "docker compose -f docker-compose.sonar.yml down -v",
    "sonar:scan": "node tooling/sonar/sonar-gate.mjs",
    "quality": "pnpm health && pnpm sonar:scan",
    "clean": "rm -rf dist coverage test-results node_modules/.tmp node_modules/.vite",
    "size": "node tooling/ci/run-size-limit.mjs",
    "size:check": "node tooling/ci/run-size-limit.mjs --json",
    "build:analyze": "ANALYZE=true vite build",
    "validate": "pnpm lint && pnpm biome:check && pnpm type-check && pnpm test",
    "ci:lint": "pnpm biome:check && pnpm lint && pnpm format:check",
    "ci:test": "pnpm test",
    "ci:build": "pnpm build && pnpm build:check && pnpm size",
    "ci:all": "pnpm health",
    "test:ci": "vitest run --coverage",
    "contracts:drift": "node tooling/ci/check-api-contract-drift.mjs",
    "docs:staleness": "node tooling/ci/check-doc-staleness.mjs",
    "coverage:patch": "node tooling/ci/check-patch-coverage.mjs --coverage coverage/coverage-final.json",
    "deps:check": "pnpm outdated",
    "deps:audit": "node tooling/ci/bulk-audit.mjs --level high",
    "deps:audit:prod": "node tooling/ci/bulk-audit.mjs --prod --level high",
    "sbom:generate": "npx -y @cyclonedx/cdxgen -t js --no-recurse -o sbom.cyclonedx.json .",
    "deploy:netlify": "pnpm build && netlify deploy",
    "deploy:netlify:prod": "pnpm build && netlify deploy --prod",
    "rebrand": "node tooling/identity/rebrand.mjs",
    "identity:sync": "node tooling/identity/rebrand.mjs --sync --apply",
    "setup:local": "tsx tooling/dev/setup-local.ts",
    "setup:mac-tools": "bash tooling/dev/setup-mac-tools.sh",
    "mcp:setup": "tsx tooling/dev/setup-mcp.ts",
    "mcp:setup:default": "tsx tooling/dev/setup-mcp.ts --default",
    "mcp:setup:check": "tsx tooling/dev/setup-mcp.ts --check",
    "mcp:setup:list": "tsx tooling/dev/setup-mcp.ts --list",
    "github:sync": "node tooling/setup/github/sync.mjs",
    "github:tool:governance-mode": "node tooling/setup/github/governance-mode.mjs",
    "github:tool:governance-mode:check": "node tooling/setup/github/governance-mode.mjs --check",
    "validate:deploy-env": "node tooling/setup/github/validate-github-env.mjs",
    "test:github-scripts": "node --import tsx --test tooling/setup/github/**/*.test.mjs tooling/dev/**/*.test.ts tooling/validate/*.test.mjs tooling/ci/*.test.mjs",
    "tool:sync-env-example": "tsx tooling/validate/sync-env-example.ts",
    "tool:sync-env-example:fix": "tsx tooling/validate/sync-env-example.ts --fix",
    "env:catalog": "node --import tsx tooling/env-registry/env-registry.ts --catalog",
    "env:catalog:check": "node --import tsx tooling/env-registry/env-registry.ts --catalog --check",
    "tool:project-structure-tree": "python3 tooling/reports/generate-project-tree.py",
    "tool:project-structure-tree:check": "python3 tooling/reports/generate-project-tree.py --check",
    "validate:env-example": "./tooling/validate/env-example.sh",
    "validate:public": "./tooling/validate/public-assets.sh",
    "validate:structure": "./tooling/validate/route-islands.sh",
    "validate:tokens": "./tooling/validate/design-tokens.sh",
    "validate:logical": "./tooling/validate/logical-css.sh",
    "validate:no-bare-intl": "node tooling/validate/no-bare-intl.mjs",
    "validate:theme-axis": "./tooling/validate/theme-axis.sh",
    "validate:theme-catalog": "node --import tsx tooling/validate/theme-catalog.mjs",
    "validate:testids": "node tooling/validate/test-ids.mjs",
    "validate:i18n": "node tooling/validate/i18n-keys.mjs",
    "validate:i18n-parity": "node tooling/validate/i18n-locale-parity.mjs",
    "validate:vite-env": "node tooling/validate/vite-env-reads.mjs",
    "validate:no-static-branch-name": "node --import tsx tooling/validate/no-static-branch-name.ts",
    "validate:identity": "node tooling/validate/identity.mjs",
    "validate:client-env": "node --import tsx tooling/validate/client-env.ts",
    "validate:lockfile": "./tooling/validate/lockfile-sync.sh",
    "health": "./tooling/validate/health-check.sh",
    "health:fix": "./tooling/validate/health-check.sh --fix",
    "sync:check": "./tooling/validate/sync-check.sh",
    "sync:check:local": "./tooling/validate/sync-check.sh --local",
    "report:code-review": "node tooling/reports/code-review-report.mjs",
    "before-commit-guard": "./tooling/validate/before-commit-guard.sh",
    "agent-os:generate": "tsx tooling/agent-os/generate.ts --write",
    "agent-os:generate:check": "tsx tooling/agent-os/generate.ts --check",
    "agent-os:check": "tsx agent-os/evals/check.ts",
    "agent-os:check:report": "tsx agent-os/evals/check.ts --report",
    "agent-os:triggers": "tsx agent-os/evals/trigger-eval.ts",
    "agent-os:triggers:strict": "tsx agent-os/evals/trigger-eval.ts --strict",
    "agent-os:lock": "tsx tooling/agent-os/lock.ts",
    "test:visual": "rm -rf test-results && playwright test tests/e2e/visual.e2e.test.ts",
    "test:visual:update": "rm -rf test-results && playwright test tests/e2e/visual.e2e.test.ts --update-snapshots",
    "prepare": "husky",
    "perf:routes": "node tooling/perf/measure-public-routes.mjs",
    "perf:routes:update": "node tooling/perf/measure-public-routes.mjs --update"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.1 <6",
      "esbuild": ">=0.28.1",
      "protobufjs": ">=7.6.4 <8",
      "minimatch": ">=10.2.5 <11",
      "nanoid@3": ">=3.3.18 <4",
      "nanoid@5": ">=5.1.16 <6",
      "multiparty": ">=4.3.0",
      "tmp": ">=0.2.6",
      "dompurify": ">=3.4.7",
      "undici@7": "^7.28.0",
      "ws": ">=8.21.0",
      "http-proxy-middleware": ">=3.0.7",
      "@modelcontextprotocol/sdk": ">=1.30.0",
      "@opentelemetry/core": ">=2.8.0",
      "@fastify/static": ">=10.1.2 <11",
      "brace-expansion": ">=5.0.8 <6",
      "fast-uri": ">=3.1.6 <4",
      "smol-toml": ">=1.8.0 <2",
      "find-my-way": ">=9.7.0 <10",
      "ip-address": ">=10.4.0 <11",
      "js-yaml@5": ">=5.2.2 <6",
      "postcss": ">=8.5.23 <9",
      "sharp": ">=0.35.1 <0.36",
      "svgo": ">=4.0.2 <5",
      "@hono/node-server": ">=2.0.5 <3",
      "hono": ">=4.12.34 <5"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --no-errors-on-unmatched",
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.75.0",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "~1.170.38",
    "@tanstack/react-table": "^9.2.4",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "posthog-js": "^1.434.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.5",
    "@biomejs/biome": "2.5.14",
    "@colbymchenry/codegraph": "^1.6.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@sentry/vite-plugin": "^5.4.0",
    "@size-limit/file": "^14.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@upstash/context7-mcp": "^4.1.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "chrome-devtools-mcp": "^1.9.0",
    "dotenv": "^18.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.10.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.0",
    "knip": "^6.36.0",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "0.23.2",
    "netlify-cli": "^27.8.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.21.0",
    "size-limit": "^14.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-mcp-server": "^0.1.1",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "vitest-axe": "^0.1.0",
    "workbox-build": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
